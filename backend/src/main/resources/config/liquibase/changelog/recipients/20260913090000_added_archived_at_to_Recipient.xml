<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Un destinatar care a primit macar un mesaj nu poate fi sters: randurile din
        message_recipient trimit catre el cu FK obligatoriu. In locul stergerii il
        arhivam - dispare din ecrane, dar istoricul trimiterilor ramane intreg.

        Coloana e nullable si fara default, deci randurile existente raman active.
    -->
    <changeSet id="20260913090000-1" author="dev">
        <addColumn tableName="recipient">
            <column name="archived_at" type="${datetimeType}" />
        </addColumn>
    </changeSet>
</databaseChangeLog>
